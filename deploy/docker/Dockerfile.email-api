# ── Stage: build-core ────────────────────────────────────────────────────────
# Clones mesahub-core and builds the Go binary from source.
FROM golang:1.24-alpine AS build-core

RUN sed -i 's|dl-cdn.alpinelinux.org|alpine.global.ssl.fastly.net|g' /etc/apk/repositories && \
    apk update && \
    apk add --no-cache gcc musl-dev sqlite-dev git

ARG MESAHUB_CORE_VERSION=trunk
RUN --mount=type=secret,id=gh_token \
    git config --global url."https://$(cat /run/secrets/gh_token)@github.com/".insteadOf "https://github.com/" && \
    git clone --depth 1 --branch ${MESAHUB_CORE_VERSION} \
    https://github.com/mesahub-db/mesahub-core.git /mesahub-core
WORKDIR /mesahub-core/server
RUN CGO_ENABLED=1 GOOS=linux go build -o /go/bin/mesahub-server ./cmd/server

# ── Stage: build-backend ──────────────────────────────────────────────────────
FROM node:22-alpine AS build-backend
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace root configuration
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy ALL workspace package manifests recorded in pnpm-lock.yaml
COPY packages/email-core/package.json packages/email-core/tsconfig.json ./packages/email-core/
COPY packages/inbox-core/package.json packages/inbox-core/tsconfig.json ./packages/inbox-core/
COPY scripts/package.json                                             ./scripts/
COPY services/email-bridge/package.json                               ./services/email-bridge/
COPY services/email-server/package.json                               ./services/email-server/
COPY services/email-ui/package.json                                   ./services/email-ui/
COPY services/email-worker/package.json                               ./services/email-worker/
COPY services/emails/package.json                                     ./services/emails/
COPY services/inbox-bridge/package.json                               ./services/inbox-bridge/
COPY services/inbox-server/package.json                               ./services/inbox-server/
COPY services/inbox-ui/package.json                                   ./services/inbox-ui/
COPY services/inbox-worker/package.json                               ./services/inbox-worker/
COPY services/landing/package.json                                    ./services/landing/

# Install backend dependencies
RUN --mount=type=cache,id=pnpm-store-backend,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source and build shared & backend packages
COPY packages/email-core/src/ ./packages/email-core/src/
RUN pnpm --filter @emailflare/email-core build

COPY services/emails/ ./services/emails/
RUN pnpm --filter @emailflare/emails build

COPY services/email-server/ ./services/email-server/
RUN pnpm --filter @emailflare/email-server build

# ── Stage: build-email-ui ────────────────────────────────────────────────────
FROM node:22-alpine AS build-email-ui
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace root configuration
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy ALL workspace package manifests recorded in pnpm-lock.yaml
COPY packages/email-core/package.json packages/email-core/tsconfig.json ./packages/email-core/
COPY packages/inbox-core/package.json packages/inbox-core/tsconfig.json ./packages/inbox-core/
COPY scripts/package.json                                             ./scripts/
COPY services/email-bridge/package.json                               ./services/email-bridge/
COPY services/email-server/package.json                               ./services/email-server/
COPY services/email-ui/package.json                                   ./services/email-ui/
COPY services/email-worker/package.json                               ./services/email-worker/
COPY services/emails/package.json                                     ./services/emails/
COPY services/inbox-bridge/package.json                               ./services/inbox-bridge/
COPY services/inbox-server/package.json                               ./services/inbox-server/
COPY services/inbox-ui/package.json                                   ./services/inbox-ui/
COPY services/inbox-worker/package.json                               ./services/inbox-worker/
COPY services/landing/package.json                                    ./services/landing/

# Install UI dependencies
RUN --mount=type=cache,id=pnpm-store-admin,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @emailflare/email-ui...

# Copy source and build UI
COPY packages/email-core/ ./packages/email-core/
COPY services/email-ui/ ./services/email-ui/
RUN pnpm --filter @emailflare/email-ui build

# ── Stage: prod (Caddy + Node) ──────────────────────────────────────────────
FROM caddy:2-alpine AS caddy-bin

FROM node:22-alpine AS prod
COPY --from=caddy-bin /usr/bin/caddy /usr/bin/caddy
RUN apk add --no-cache curl openssl
WORKDIR /app

# mesahub-server (for embedded mode)
COPY --from=build-core /go/bin/mesahub-server /usr/local/bin/mesahub-server
RUN mkdir -p /data
VOLUME ["/data"]

RUN mkdir -p /usr/share/caddy

# Workspace manifests
COPY package.json pnpm-workspace.yaml ./

# Backend runtime and all dependency symlinks
COPY --from=build-backend /app/node_modules                     ./node_modules
COPY --from=build-backend /app/packages/email-core              ./packages/email-core
COPY --from=build-backend /app/services/emails                  ./services/emails
COPY --from=build-backend /app/services/email-server            ./services/email-server

# Email UI static files
COPY --from=build-email-ui /app/services/email-ui/dist /usr/share/caddy

COPY deploy/docker/start-email-api.sh /app/start-email-api.sh
RUN chmod +x /app/start-email-api.sh

EXPOSE 80
CMD ["/app/start-email-api.sh"]